    },
    "ClaimKind": {
      "type": "string",
      "enum": [
        "descriptive",
        "causal",
        "comparative",
        "normative",
        "procedural",
        "meta"
      ]
    },
    "LeakageType": {
      "type": "string",
      "enum": [
        "false_completeness",
        "causal_overreach",
        "audience_misfit",
