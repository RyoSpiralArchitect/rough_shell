        },
        "factual_strictness": {
          "$ref": "#/$defs/Level3"
        },
        "ambiguity_tolerance": {
          "$ref": "#/$defs/Level3"
        },
        "exploration_width": {
          "type": "string",
          "enum": [
            "narrow",
            "medium",
            "wide"
          ]
