        "audience",
        "stakes",
        "factual_strictness",
        "ambiguity_tolerance",
        "exploration_width",
        "projection_style",
        "budgets"
      ]
    },
    "ContractPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "$ref": "#/$defs/Audience"
        },
        "stakes": {
