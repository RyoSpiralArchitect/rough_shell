        "mandatory_exposures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "clarification_needs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "anchor_touch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "obstruction_touch": {
