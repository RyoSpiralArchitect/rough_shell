    "Stakes": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Level3": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "Priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "ProjectionStyle": {
      "type": "string",
      "enum": [
        "auto",
        "single",
        "branched",
        "meta",
        "clarify"
      ]
    },
    "Warrant": {
      "type": "string",
      "enum": [
        "local_inference",
        "user_asserted",
        "source_observed",
        "externally_verified"
      ]
    },
    "AnchorKind": {
      "type": "string",
      "enum": [
        "veto",
        "constraint",
        "preference"
      ]
    },
    "AnchorScope": {
