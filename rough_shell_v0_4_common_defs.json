    "FindingCategory": {
      "type": "string",
      "enum": [
        "provenance",
        "bridge",
        "implicature",
        "scope_coverage",
        "negotiation_fidelity",
        "unsupported_claim",
        "scar_underexposure",
        "scar_overexposure"
      ]
