        "scar_density_max": {
          "type": "integer",
          "minimum": 0
        },
        "branch_budget": {
          "type": "integer",
          "minimum": 0
        },
        "clarification_budget": {
          "type": "integer",
          "minimum": 0
        },
        "meta_projection_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "answer_tokens",
        "scar_density_max",
        "branch_budget",
        "clarification_budget",
        "meta_projection_allowed"
      ]
    },
    "Contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": {
          "$ref": "#/$defs/Audience"
        },
        "stakes": {
          "$ref": "#/$defs/Stakes"
        },
        "factual_strictness": {
          "$ref": "#/$defs/Level3"
        },
        "ambiguity_tolerance": {
          "$ref": "#/$defs/Level3"
        },
        "exploration_width": {
          "type": "string",
          "enum": [
            "narrow",
            "medium",
            "wide"
          ]
        },
        "projection_style": {
          "$ref": "#/$defs/ProjectionStyle"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        }
