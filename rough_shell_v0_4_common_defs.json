              "minimum": 1
            },
            "scar_density_max": {
              "type": "integer",
              "minimum": 0
            },
            "branch_budget": {
              "type": "integer",
              "minimum": 0
            },
            "clarification_budget": {
              "type": "integer",
              "minimum": 0
            },
            "meta_projection_allowed": {
