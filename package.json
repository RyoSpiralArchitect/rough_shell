{
  "name": "rough-shell-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "clean": "rm -rf packages/*/dist apps/*/dist",
    "cli": "npm run build --silent && node apps/cli/dist/index.js",
    "cli:mock": "npm run cli -- --provider mock",
    "cli:mistral": "npm run cli -- --provider mistral --model mistral-large-latest",
    "smoke": "npm run build --silent && node scripts/smoke-prompts.mjs && node scripts/smoke-state-delta.mjs && node scripts/smoke-threaded-heuristics.mjs && node scripts/smoke-openai-compat-normalization.mjs && node scripts/smoke-cli-mock.mjs && node scripts/smoke-viewer.mjs && node scripts/smoke-forks.mjs",
    "smoke:mock": "npm run build --silent && node scripts/smoke-cli-mock.mjs",
    "viewer": "npm run build --silent && node apps/viewer/dist/index.js",
    "viewer:demo": "npm run viewer -- --demo",
    "viewer:fork-demo": "npm run viewer -- --fork-demo",
    "smoke:viewer": "npm run build --silent && node scripts/smoke-viewer.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
