        "answer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "turn",
        "projection_ir",
        "answer"
      ]
    },
    "AuditFinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/FindingCategory"
        },
        "severity": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Level3"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/FixAction"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "target_ids",
        "description",
        "fix",
        "status"
      ]
    },
    "AuditResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "const": "v0.5"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "verdict": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Verdict"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "required_actions": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/FixAction"
          },
          "default": []
        },
        "projection_style_recommendation": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/ProjectionStyle"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuditFinding"
          }
        },
        "revised_answer": {
          "type": "string"
        },
        "revised_projection_ir": {
          "$ref": "#/$defs/ProjectionIR"
        }
      },
      "required": [
        "version",
        "turn",
        "verdict",
        "summary",
        "required_actions",
        "projection_style_recommendation",
        "findings"
      ]
    }
  }
}
