{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rough_shell_v0_5_common_defs.json",
  "title": "rough-shell-v0.5 common definitions",
  "$defs": {
    "TraceAction": {
      "type": "string",
      "enum": [
        "anchor_add",
        "anchor_relax",
        "fork",
        "suspend",
        "obstruct",
        "revive",
        "resolve",
        "retire",
        "project",
        "contract_shift",
        "negotiate",
        "audit_rewrite",
        "reframe"
      ]
    },
    "FindingCategory": {
      "type": "string",
      "enum": [
        "provenance",
        "bridge",
        "implicature",
        "scope_coverage",
        "negotiation_fidelity",
        "unsupported_claim",
        "scar_underexposure",
        "scar_overexposure",
        "frame_narrowing"
      ]
    },
    "AnchorExposurePolicy": {
      "type": "string",
      "enum": [
        "latent",
        "expose_if_touched",
        "always_expose"
      ]
    },
    "InterpretationOpeningStatus": {
      "type": "string",
      "enum": [
        "open",
        "selected",
        "collapsed",
        "rejected"
      ]
    },
    "RejectedVariantKind": {
      "type": "string",
      "enum": [
        "interpretation_frame",
        "section_variant",
        "frontier",
        "claim_strategy"
      ]
    },
    "RejectedBy": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "audit",
        "inferred"
      ]
    },
    "DomainMode": {
      "type": "string",
      "enum": [
        "factual",
        "hypothetical",
        "fictional",
        "symbolic"
      ]
    },
    "ClaimKind": {
      "type": "string",
      "enum": [
        "descriptive",
        "causal",
        "comparative",
        "normative",
        "procedural",
        "meta",
        "speculative"
      ]
    },
    "Anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/AnchorKind"
        },
        "priority": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Priority"
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "system",
            "domain",
            "inferred"
          ]
        },
        "scope": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/AnchorScope"
        },
        "status": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/AnchorStatus"
        },
        "exposure_policy": {
          "$ref": "#/$defs/AnchorExposurePolicy"
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "priority",
        "source",
        "scope",
        "status",
        "exposure_policy"
      ]
    },
    "AnchorExposureUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "exposure_policy": {
          "$ref": "#/$defs/AnchorExposurePolicy"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "exposure_policy",
        "reason"
      ]
    },
    "InterpretationOpening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "type": "string",
          "minLength": 1
        },
        "changes_if_selected": {
          "type": "string",
          "minLength": 1
        },
        "clarification_prompt": {
          "type": "string",
          "minLength": 1
        },
        "collapsible_with_one_clarification": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/InterpretationOpeningStatus"
        },
        "competes_with": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "related_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "label",
        "reading",
        "changes_if_selected",
        "clarification_prompt",
        "collapsible_with_one_clarification",
        "status",
        "competes_with",
        "related_sections"
      ]
    },
    "InterpretationOpeningPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/InterpretationOpeningStatus"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "clarification_prompt": {
          "type": "string",
          "minLength": 1
        },
        "related_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "reason"
      ]
    },
    "RejectedVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/RejectedVariantKind"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "rejected_by": {
          "$ref": "#/$defs/RejectedBy"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "superseded_by": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "summary",
        "derived_from",
        "rejected_by",
        "reason",
        "superseded_by",
        "turn"
      ]
    },
    "Section": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "gist": {
          "type": "string",
          "minLength": 1
        },
        "warrant": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Warrant"
        },
        "domain_mode": {
          "$ref": "#/$defs/DomainMode"
        },
        "status": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/SectionStatus"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "revive_when": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "projection_signature": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/ProjectionSignature"
        },
        "branch_cost": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/BranchCost"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "id",
        "label",
        "gist",
        "warrant",
        "domain_mode",
        "status",
        "parents",
        "revive_when",
        "projection_signature",
        "branch_cost",
        "variants"
      ]
    },
    "SectionPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "gist": {
          "type": "string"
        },
        "warrant": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Warrant"
        },
        "domain_mode": {
          "$ref": "#/$defs/DomainMode"
        },
        "status": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/SectionStatus"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revive_when": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projection_signature": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/ProjectionSignature"
        },
        "branch_cost": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/BranchCost"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "Trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/TraceAction"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cause": {
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "action",
        "targets",
        "cause",
        "turn"
      ]
    },
    "ShellState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "const": "v0.5"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "contract": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Contract"
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Anchor"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "voids": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Void"
          }
        },
        "obstructions": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Obstruction"
          }
        },
        "negotiations": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Negotiation"
          }
        },
        "interpretation_openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterpretationOpening"
          }
        },
        "rejected_variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RejectedVariant"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Trace"
          }
        }
      },
      "required": [
        "version",
        "turn",
        "contract",
        "anchors",
        "sections",
        "voids",
        "obstructions",
        "negotiations",
        "interpretation_openings",
        "rejected_variants",
        "traces"
      ]
    },
    "StateDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "const": "v0.5"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "contract_patch": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/ContractPatch"
        },
        "add_anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Anchor"
          }
        },
        "update_anchor_status": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/AnchorStatusUpdate"
          }
        },
        "update_anchor_exposure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnchorExposureUpdate"
          }
        },
        "add_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "update_sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionPatch"
          }
        },
        "add_interpretation_openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterpretationOpening"
          }
        },
        "update_interpretation_openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InterpretationOpeningPatch"
          }
        },
        "add_rejected_variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RejectedVariant"
          }
        },
        "add_voids": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Void"
          }
        },
        "resolve_voids": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/VoidResolution"
          }
        },
        "add_obstructions": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Obstruction"
          }
        },
        "clear_obstructions": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/ObstructionClear"
          }
        },
        "add_negotiations": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Negotiation"
          }
        },
        "update_negotiations": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/NegotiationPatch"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Trace"
          }
        }
      },
      "required": [
        "version",
        "turn",
        "rationale",
        "contract_patch",
        "add_anchors",
        "update_anchor_status",
        "update_anchor_exposure",
        "add_sections",
        "update_sections",
        "add_interpretation_openings",
        "update_interpretation_openings",
        "add_rejected_variants",
        "add_voids",
        "resolve_voids",
        "add_obstructions",
        "clear_obstructions",
        "add_negotiations",
        "update_negotiations",
        "traces"
      ]
    },
    "NegotiationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "const": "v0.5"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "projection_style_recommendation": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/ProjectionStyle"
        },
        "global_reason": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/NegotiationDecision"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Trace"
          }
        }
      },
      "required": [
        "version",
        "turn",
        "projection_style_recommendation",
        "global_reason",
        "decisions",
        "traces"
      ]
    },
    "ClaimFrame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "text_intent": {
          "type": "string",
          "minLength": 1
        },
        "warrant": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Warrant"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "licensed_if": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "drop_if_unexposed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "section",
        "kind",
        "text_intent",
        "warrant",
        "depends_on",
        "licensed_if",
        "drop_if_unexposed"
      ]
    },
    "ProjectionIR": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_frontiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "frame_commitments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "claim_frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimFrame"
          }
        },
        "scars": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Scar"
          }
        },
        "withheld": {
          "type": "array",
          "items": {
            "$ref": "rough_shell_v0_4_common_defs.json#/$defs/Withheld"
          }
        },
        "body_plan": {
          "$ref": "rough_shell_v0_4_common_defs.json#/$defs/BodyPlan"
        }
      },
      "required": [
        "selected_frontiers",
        "frame_commitments",
        "claim_frames",
        "scars",
        "withheld",
        "body_plan"
      ]
    },
    "ProjectionOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "const": "v0.5"
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "projection_ir": {
          "$ref": "#/$defs/ProjectionIR"
